# ── Supabase staging (mumtaz-mop-staging, region: ap-south-1 / Mumbai) ──
# This project is BOTH the staging and the development database — there is no
# local Docker DB (see DECISIONS.md §2.A).
# Copy this file to `.env.local` and fill in the real values there.
# `.env.local` is git-ignored and must NEVER be committed.
#
# Where to find each value in the Supabase dashboard:
#   Project → Settings → Data API      → Project URL
#   Project → Settings → API Keys      → publishable / anon key
#   Project → Settings → Database      → Connection string (and the password you set)

# Public project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL="https://xpkniuhcjysisfbfiqhn.supabase.co"

# Publishable / anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="paste-publishable-key-here"

# Direct Postgres connection string for migrations & the worker (SECRET).
# Contains the database password — server-side only, never sent to a browser.
DATABASE_URL="postgresql://postgres:PASSWORD@db.xpkniuhcjysisfbfiqhn.supabase.co:5432/postgres"

# Service-role key (SECRET) — full admin access, server-side only.
SUPABASE_SERVICE_ROLE_KEY="paste-service-role-key-here"

# ── Google Maps (DECISIONS §2.B) ───────────────────────────────────────
# Browser key for map DISPLAY + one-time GEOCODING only. Referrer-restricted,
# and restricted to the Maps JavaScript API + Geocoding API. NOT used for
# routing/matrix (Art. XIII §2 — those stay on VROOM/ORS).
# This value is exposed to the browser by design; its safety comes from the
# HTTP-referrer + API restrictions and the per-API daily quota cap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="paste-restricted-google-maps-browser-key-here"
