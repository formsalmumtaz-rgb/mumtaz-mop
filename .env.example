# ── Supabase staging (mumtaz-mop-staging, region: ap-south-1 / Mumbai) ──
# This project is BOTH the staging and the development database — there is no
# local Docker DB (see DECISIONS.md §2.A).
# Copy this file to `.env.local` and fill in the real values there.
# `.env.local` is git-ignored and must NEVER be committed.
#
# Where to find each value in the Supabase dashboard:
#   Project → Settings → Data API      → Project URL
#   Project → Settings → API Keys      → publishable / anon key
#   Project → Settings → Database      → Connection string (and the password you set)

# Public project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL="https://xpkniuhcjysisfbfiqhn.supabase.co"

# Publishable / anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="paste-publishable-key-here"

# Direct Postgres connection string for migrations & the worker (SECRET).
# Contains the database password — server-side only, never sent to a browser.
DATABASE_URL="postgresql://postgres:PASSWORD@db.xpkniuhcjysisfbfiqhn.supabase.co:5432/postgres"

# Service-role key (SECRET) — full admin access, server-side only.
SUPABASE_SERVICE_ROLE_KEY="paste-service-role-key-here"

# ── Google Maps (DECISIONS §2.B / Constitution Art. XVII) ──────────────
# TWO keys. Never swap their roles.
#
# BROWSER key — map DISPLAY only. Exposed in page source by design; its safety
# is the HTTP-referrer (domain) restriction + Maps-JavaScript-API-only + quota.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY="paste-browser-key-here"
#
# SERVER key — GEOCODING only (Route Optimization added at Phase 4). NEVER sent
# to the browser (no NEXT_PUBLIC_ prefix). Restricted to the Geocoding API +
# hard quota cap. IP restriction is a pre-production item (DEBT.md D7).
GOOGLE_GEOCODING_API_KEY="paste-server-key-here"

# ── Outbox drain endpoint auth (docs/outbox-eventing.md) ───────────────
# Shared secret the Supabase webhook + sweeper send as x-drain-secret. Required
# before deploy; unset in dev allows the endpoint (do not deploy unset).
OUTBOX_DRAIN_SECRET=""

# ── Cloudflare R2 (photo/signature storage) ────────────────────────────
# Server-side ONLY (never NEXT_PUBLIC) — media uploads go through the server.
# In the Cloudflare dashboard → R2:
#   R2_ACCOUNT_ID        - R2 overview (the ID in the S3 endpoint <id>.r2.cloudflarestorage.com)
#   R2_ACCESS_KEY_ID     - R2 → Manage API Tokens → Create API token (Object Read & Write)
#   R2_SECRET_ACCESS_KEY - shown ONCE when the token is created
#   R2_BUCKET            - the bucket you create (e.g. mop-media)
#   R2_PUBLIC_BASE_URL   - optional: public bucket / custom-domain URL for reads
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# Environment binding for the costing gate (mig 026). Leave UNSET/production in
# production so assumed-costing is refused (fail-safe). Set to development/staging
# in non-production to allow computing on ASSUMED cost config (every figure flagged).
MOP_ENV=development
